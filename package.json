{
  "name": "@hsnaydd/xstyle",
  "version": "0.1.0",
  "description": "Config-driven style engine that converts typed style objects into atomic CSS classes.",
  "license": "MIT",
  "author": "Hasan Aydoğdu (https://github.com/hsnaydd)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsnaydd/xstyle.git"
  },
  "bugs": {
    "url": "https://github.com/hsnaydd/xstyle/issues"
  },
  "homepage": "https://github.com/hsnaydd/xstyle#readme",
  "keywords": [
    "css",
    "atomic-css",
    "css-in-js",
    "design-tokens",
    "typescript",
    "vite-plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.0 || >=24"
  },
  "bin": {
    "xstyle": "./bin/xstyle.mjs"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:ts": "tsc",
    "lint": "pnpm lint:eslint && pnpm lint:ts",
    "format": "prettier . --write && pnpm lint:eslint --fix",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "build": "vite build",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@hsnaydd/eslint-config": "^3.0.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
