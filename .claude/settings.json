{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": ".claude/plans",
  "permissions": {
    "allow": [
      "Bash(cat*)",
      "Bash(cp*)",
      "Bash(echo*)",
      "Bash(find*)",
      "Bash(gh api:*)",
      "Bash(gh pr:*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git add*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git commit*)",
      "Bash(git config --unset sequence.editor*)",
      "Bash(git config sequence.editor *)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git log*)",
      "Bash(git merge*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git remote*)",
      "Bash(git rev-list*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(git status*)",
      "Bash(git switch*)",
      "Bash(grep*)",
      "Bash(head*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(mv*)",
      "Bash(node*)",
      "Bash(npm --version)",
      "Bash(npx*)",
      "Bash(pnpm --filter * build*)",
      "Bash(pnpm --filter * lint*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --version)",
      "Bash(pnpm add*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm format*)",
      "Bash(pnpm install*)",
      "Bash(pnpm lingui:*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm list*)",
      "Bash(pnpm start*)",
      "Bash(pnpm test*)",
      "Bash(pwd*)",
      "Bash(sort*)",
      "Bash(tail*)",
      "Bash(touch*)",
      "Bash(wc*)",
      "Bash(which*)"
    ],
    "deny": [
      "Bash(chmod 777*)",
      "Bash(chown*)",
      "Bash(curl *|bash*)",
      "Bash(dd*)",
      "Bash(docker*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(kubectl*)",
      "Bash(mkfs*)",
      "Bash(rm -rf *)",
      "Bash(sudo*)",
      "Bash(wget *|bash*)",
      "Read(./.env.*)",
      "Read(./.env)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
